<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (system tray) comes from WinForms -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>VU1_Icon.ico</ApplicationIcon>
    <Authors>$(AssemblyName)</Authors>
    <AssemblyName>VU1-Demo-App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Logger.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="VU1_Icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="VU1_Icon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="VU1_Icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Bundled dial image templates (from /image_pack) are copied to <output>\Templates.
       Users can add more templates to %USERPROFILE%\KaranovicResearch\VU1-DemoApp\templates -->
  <ItemGroup>
    <Content Include="..\image_pack\**\*.png;..\image_pack\**\*.jpg;..\image_pack\**\*.jpeg;..\image_pack\**\*.bmp">
      <Link>Templates\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Bundled fonts (Inter + optional JetBrains Mono, see Fonts/README.txt) -->
  <ItemGroup>
    <Resource Include="Fonts\**\*.otf;Fonts\**\*.ttf" />
    <None Include="Fonts\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.3" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="YamlDotNet" Version="13.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Build date stamp (yyyyMMdd) shown in the title bar / About window.
       Pure MSBuild, so no PowerShell dependency. -->
  <Target Name="WriteBuildDate" BeforeTargets="PrepareForBuild">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\Resources\BuildDate.txt"
                      Lines="$([System.DateTime]::Now.ToString('yyyyMMdd'))"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
