<Window x:Class="VU1WPF.BacklightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindow}"
        Background="{StaticResource PanelBrush}"
        Title="Backlight" Width="580" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <DataTemplate x:Key="PaletteItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="24,18,24,20">

        <!-- ============================================================ fixed colour -->
        <TextBlock Text="Fixed colour" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
        <TextBlock Text="Used whenever the colour rules below are switched off." Foreground="{StaticResource MutedBrush}"
                   FontSize="12" Margin="0,0,0,12"/>

        <ItemsControl x:Name="presetTiles" Margin="0,0,-8,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ColorTile}" Tag="{Binding IsSelected}" Click="PresetTile_Click" ToolTip="{Binding Tooltip}">
                        <StackPanel>
                            <Ellipse Width="22" Height="22" Fill="{Binding Brush}" HorizontalAlignment="Center"
                                     Stroke="#33FFFFFF" StrokeThickness="1">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{Binding GlowColor}" Opacity="{Binding GlowOpacity}"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- custom colour -->
        <Border x:Name="customPanel" Visibility="Collapsed" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,2,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Red" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Row="0" Grid.Column="1" x:Name="sliderRed" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="CustomSlider_ValueChanged"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=sliderRed, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="Green" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Row="1" Grid.Column="1" x:Name="sliderGreen" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="CustomSlider_ValueChanged"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=sliderGreen, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="Blue" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Row="2" Grid.Column="1" x:Name="sliderBlue" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="CustomSlider_ValueChanged"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=sliderBlue, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border x:Name="customSwatch" Height="40" CornerRadius="8" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                            Background="#FF2A2C30" Margin="0,0,0,8"/>
                    <Button Content="Use colour" Style="{StaticResource PrimaryButton}" Click="btnApplyCustom_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Separator Margin="0,18,0,16"/>

        <!-- ============================================================ rules -->
        <DockPanel>
            <CheckBox x:Name="chkRules" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                      ToolTip="Turn the colour rules on or off" Checked="chkRules_Changed" Unchecked="chkRules_Changed"/>
            <StackPanel>
                <TextBlock Text="Rules by value" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                <TextBlock Text="Colour follows the dial value (0-100 %, after the 0% / 100% scaling). Overrides the fixed colour while on."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0"/>
            </StackPanel>
        </DockPanel>

        <StackPanel x:Name="rulesPanel" Margin="0,14,0,0">
            <!-- colour bar 0..100 % -->
            <Grid x:Name="rangeBar" Height="10"/>
            <Grid Margin="0,4,0,0">
                <TextBlock Text="0%" FontSize="10" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Left"/>
                <TextBlock Text="50%" FontSize="10" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="100%" FontSize="10" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right"/>
            </Grid>

            <StackPanel x:Name="rulesRows" Margin="0,10,0,0"/>
            <TextBlock x:Name="txtNoRanges" Text="No ranges yet. Add a range, or start from the example."
                       Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="0,4,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="+ Add range" Style="{StaticResource GhostButton}" Click="btnAddRange_Click"
                        ToolTip="Split the last range in two"/>
                <Button Content="Use example" Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="btnExample_Click"
                        ToolTip="White up to 10 %, green 11-50 %, yellow 51-80 %, red 81-100 %"/>
            </StackPanel>
        </StackPanel>

        <Separator Margin="0,18,0,14"/>

        <!-- ============================================================ footer -->
        <DockPanel LastChildFill="False">
            <ComboBox x:Name="cbCopyFrom" DockPanel.Dock="Left" Width="180" Tag="Copy rules from…"
                      DisplayMemberPath="FriendlyName" SelectionChanged="cbCopyFrom_SelectionChanged"
                      ToolTip="Replace this dial's rules with the rules of another dial"/>
            <Button DockPanel.Dock="Left" Content="Apply to all dials" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Click="btnApplyAll_Click" ToolTip="Copy these rules (and the on/off state) to every dial"/>
            <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource PrimaryButton}" Click="btnDone_Click"/>
        </DockPanel>
        <TextBlock x:Name="txtStatus" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
