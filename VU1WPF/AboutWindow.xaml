<Window x:Class="VU1WPF.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindow}"
        Background="{StaticResource PanelBrush}"
        Title="About" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <StackPanel Margin="24,22,24,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="18" Height="18" CornerRadius="5" BorderThickness="2"
                    BorderBrush="{StaticResource AccentBrush}" Background="#FF2B2D31" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="VU1 Dials - Demo App" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="20">
            A simple demonstration of what the VU1 dials can do: show live computer metrics on
            analogue needles, change the backlight colour with the value, and put your own images on the e-ink display.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" LineHeight="20">
            Sensor readings are provided by LibreHardwareMonitor.
        </TextBlock>

        <Button Style="{StaticResource LinkButton}" Content="https://vudials.com" HorizontalAlignment="Left"
                Margin="0,12,0,0" Click="btnWebsite_Click"/>

        <TextBlock x:Name="txtBuildStamp" FontSize="11" Foreground="{StaticResource FaintBrush}" Margin="0,18,0,0"/>

        <Button Content="Close" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,16,0,0"
                IsCancel="True" IsDefault="True" Click="btnCloseWindow"/>
    </StackPanel>
</Window>
