<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        VU1 dark theme. Colours follow the dial: charcoal housing, light e-ink screen,
        orange needle as the single accent colour.
    -->

    <!-- ================================================================ colours -->
    <Color x:Key="BgColor">#FF141517</Color>
    <Color x:Key="PanelColor">#FF1B1C1F</Color>
    <Color x:Key="SurfaceColor">#FF26282C</Color>
    <Color x:Key="SurfaceHoverColor">#FF2F3136</Color>
    <Color x:Key="InputColor">#FF151618</Color>
    <Color x:Key="LineColor">#FF2C2E33</Color>
    <Color x:Key="LineStrongColor">#FF3A3D43</Color>
    <Color x:Key="TextColor">#FFE8E8E6</Color>
    <Color x:Key="MutedColor">#FF8B8E94</Color>
    <Color x:Key="FaintColor">#FF5C5F65</Color>
    <Color x:Key="AccentColor">#FFE0662A</Color>
    <Color x:Key="AccentHoverColor">#FFEA7A43</Color>
    <Color x:Key="OkColor">#FF3CCF6A</Color>
    <Color x:Key="WarnColor">#FFF2B33D</Color>
    <Color x:Key="DangerColor">#FFE5484D</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#66E0662A"/>

    <!-- Fallback fonts. App.xaml.cs replaces these at start-up with the bundled fonts
         (Fonts/Inter*.otf etc.), so always reference them with DynamicResource. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="DisplayFont">Cascadia Mono, Consolas</FontFamily>

