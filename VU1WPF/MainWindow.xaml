<Window x:Class="VU1WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VU1WPF"
        mc:Ignorable="d"
        Style="{StaticResource DarkWindow}"
        Title="VU1 Dials"
        Width="1220" SizeToContent="Height" MinHeight="300"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" WindowStyle="None"
        Closing="mainWindow_Closing">

    <!-- Custom (dark) title bar; native drag/snap behaviour is kept by WindowChrome -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#FF26282C" BorderThickness="1">
        <DockPanel>

            <!-- ============================================================ title bar -->
            <Border DockPanel.Dock="Top" Height="40" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0,6,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource IconTray}" ToolTip="Minimize to system tray"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="btnMinToTray_Click"/>
                        <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource IconMinimize}" ToolTip="Minimize"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="btnMin_Click"/>
                        <Button Style="{StaticResource CaptionCloseButton}" Tag="{StaticResource IconClose}" ToolTip="Close"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="btnX_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="14" Height="14" CornerRadius="4" BorderThickness="2"
                                BorderBrush="{StaticResource AccentBrush}" Background="#FF2B2D31" Margin="0,0,9,0"/>
                        <TextBlock Text="VU1 Dials - Demo Application" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtVersion" Foreground="{StaticResource MutedBrush}" FontSize="11" FontFamily="{DynamicResource MonoFont}"
                                   Margin="8,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================================================ status bar -->
            <Border DockPanel.Dock="Bottom" Height="38" Background="#FF111214"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="16,0,8,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnToggleDialUpdate" Style="{StaticResource IconButton}" Tag="{StaticResource IconPause}"
                                ToolTip="Pause sending values to the dials" Click="btnToggleDialUpdate_click"/>
                        <Button x:Name="btnRefreshDials" Style="{StaticResource IconButton}" Tag="{StaticResource IconRefresh}"
                                ToolTip="Reload dials from the VU1 server" Click="btnRefreshDials_click"/>
                        <Border Width="1" Height="18" Background="{StaticResource LineBrush}" Margin="6,0"/>
                        <Button x:Name="btnAbout" Style="{StaticResource IconButton}" Tag="{StaticResource IconInfo}"
                                ToolTip="About" Click="btnAbout_click"/>
                        <Button x:Name="btnSettings" Style="{StaticResource IconButton}" Tag="{StaticResource IconGear}"
                                ToolTip="Settings" Click="btnSettings_click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource WarnBrush}" Margin="0,0,9,0">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="StatusGlow" BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="{StaticResource WarnColor}"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="txtServerStatus" Text="Connecting…" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtServerDetail" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontFamily="{DynamicResource MonoFont}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================================================ dials -->
            <Grid MinHeight="420">
                <Grid.Background>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.8" RadiusY="0.9">
                        <GradientStop Color="#FF1E2024" Offset="0"/>
                        <GradientStop Color="#FF131416" Offset="1"/>
                    </RadialGradientBrush>
                </Grid.Background>
                <ScrollViewer x:Name="DialScroller" Style="{StaticResource OverlayScrollViewer}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" Focusable="False">
                    <ItemsControl x:Name="DialsHost" Margin="18,20,18,20" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 4 cards (270 + 2x10 margin) per row -->
                                <WrapPanel MaxWidth="1160" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:DialCard Margin="10"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="txtEmptyTitle" Text="No dials found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtEmptyDetail" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420"
                               Text="Make sure the VU1 server is running and the dials are connected."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Retry" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="btnRefreshDials_click"/>
                        <Button Content="Open settings" Style="{StaticResource PrimaryButton}" Click="btnSettings_click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
