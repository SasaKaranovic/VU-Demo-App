<UserControl x:Class="VU1WPF.DialCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="270" AllowDrop="True"
             DragEnter="Card_DragEnter" DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Small "?" help badge; the explanation is in the ToolTip -->
        <Style x:Key="HelpBadge" TargetType="Border">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="CornerRadius" Value="6.5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource FaintBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        </Style>

        <!-- Finish selector swatch -->
        <Style x:Key="FinishSwatch" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="1.5"/>
                            <Ellipse Margin="3" Fill="{TemplateBinding Background}" Stroke="#FF44464B" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardBorder" BorderBrush="#FF26282C" BorderThickness="1" CornerRadius="16" Padding="16,16,16,14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF1C1D20" Offset="0"/>
                <GradientStop Color="#FF161719" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel>

            <!-- ======================================================== dial (drag handle) -->
            <Grid x:Name="DialBody" Width="230" Height="236" Margin="0,0,0,22" Cursor="SizeAll" Background="Transparent"
                  ToolTip="Drag to rearrange the dials · double-click to identify this dial"
                  MouseLeftButtonDown="DialBody_MouseLeftButtonDown" MouseMove="DialBody_MouseMove">

                <!-- identify halo (animated in code) -->
                <Border x:Name="IdentifyHalo" CornerRadius="34" Margin="-4" BorderThickness="2" BorderBrush="#E6FFFFFF"
                        Opacity="0" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="White" Opacity="0.7"/>
                    </Border.Effect>
                </Border>

                <!-- brushed aluminium frame -->
                <Border CornerRadius="30" Background="{Binding HousingBrush}" BorderBrush="{Binding HousingEdgeBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.55" Color="Black"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="29" Margin="1" BorderThickness="1.2" BorderBrush="{Binding HousingBevelBrush}" IsHitTestVisible="False"/>

                <!-- glass front panel (dark glass behind which the screen sits) -->
                <Border Margin="9" CornerRadius="22" BorderBrush="#B3000000" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF1D1E21" Offset="0"/>
                            <GradientStop Color="#FF121315" Offset="0.55"/>
                            <GradientStop Color="#FF0C0D0E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- e-ink screen with backlight glow -->
                <Border x:Name="Screen" Width="182" Height="131" Margin="24,28,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="10"
                        Background="{Binding ScreenBrush}" BorderBrush="#80000000" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="{Binding GlowColor}" Opacity="{Binding GlowOpacity}"/>
                    </Border.Effect>
                    <Grid>
                        <!-- 200x144 display area -->
                        <Grid Margin="8,7">
                            <Image Source="{Binding ScreenImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Viewbox Stretch="Fill">
                                <Canvas Width="200" Height="144" ClipToBounds="True">
                                    <Canvas x:Name="NeedleLayer" Width="200" Height="144">
                                        <Canvas.Effect>
                                            <DropShadowEffect BlurRadius="2" ShadowDepth="1.5" Direction="300" Opacity="0.35" Color="Black"/>
                                        </Canvas.Effect>
                                        <Canvas.RenderTransform>
                                            <RotateTransform x:Name="NeedleRotate"/>
                                        </Canvas.RenderTransform>
                                        <Line x:Name="NeedleBase" Stroke="#FFF4F4F2" StrokeStartLineCap="Round" StrokeEndLineCap="Flat"/>
                                        <Line x:Name="NeedleTip" Stroke="#FFE0662A" StrokeStartLineCap="Flat" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <!-- inner shading -->
                        <Border CornerRadius="9" BorderThickness="2.5" BorderBrush="#26000000" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- backlight LED strip -->
                <Border Width="26" Height="3" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,201,0,0" Background="{Binding LedBrush}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{Binding GlowColor}" Opacity="{Binding GlowOpacity}"/>
                    </Border.Effect>
                </Border>

                <!-- glossy glass: diagonal reflection band, soft top light and a thin top edge highlight -->
                <Border Margin="9" CornerRadius="22" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8">
                            <GradientStop Color="#36FFFFFF" Offset="0"/>
                            <GradientStop Color="#12FFFFFF" Offset="0.34"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.345"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.82"/>
                            <GradientStop Color="#0AFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border Margin="9" CornerRadius="22" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1CFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.2"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border Margin="10" CornerRadius="21" BorderThickness="0,1,0,0" BorderBrush="#33FFFFFF" IsHitTestVisible="False"/>

                <!-- image editor (on top of the glass so it stays clickable and crisp) -->
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconGear}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="176,34,0,0"
                        Width="24" Height="24" Padding="4" Cursor="Hand"
                        Background="#C0141517" Foreground="#FFE8E8E6"
                        ToolTip="Dial image: upload an image, use a template, add text or draw"
                        Click="Gear_Click"/>
            </Grid>

            <!-- ======================================================== name + value (display font) -->
            <Grid>
                <TextBlock x:Name="NameText" Text="{Binding Name}" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="0,0,64,0" VerticalAlignment="Center"
                           Cursor="IBeam" ToolTip="Click to rename" MouseLeftButtonDown="NameText_MouseLeftButtonDown"/>
                <TextBox x:Name="NameEdit" Visibility="Collapsed" FontFamily="{DynamicResource DisplayFont}" FontSize="15" Margin="0,0,64,0" MinHeight="28"
                         KeyDown="NameEdit_KeyDown" LostKeyboardFocus="NameEdit_LostKeyboardFocus"/>
                <TextBlock Text="{Binding PercentText}" FontFamily="{DynamicResource DisplayFont}" FontSize="15"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding StatusText}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                       Foreground="{Binding StatusBrush}" Margin="0,5,0,12" TextTrimming="CharacterEllipsis"/>

            <!-- ======================================================== metric & scaling (collapsible, shared state) -->
            <Button Click="MetricsHeader_Click" Cursor="Hand" Focusable="False"
                    ToolTip="Show / hide metric and scaling on all dials">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,8">
                            <DockPanel>
                                <Path x:Name="Chevron" DockPanel.Dock="Right" Data="{StaticResource IconChevronDown}" Fill="{StaticResource MutedBrush}"
                                      Width="12" Height="12" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ui.MetricsExpanded}" Value="False">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock x:Name="HeaderText" Text="Metric &amp; scaling" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderText" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="Chevron" Property="Fill" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Height is animated in code (slide in/out) -->
            <Border x:Name="MetricsHost" ClipToBounds="True">
            <StackPanel x:Name="MetricsPanel" Margin="0,2,0,0">
                <ComboBox x:Name="cbSensor" Margin="0,0,0,10"
                          ItemsSource="{Binding SensorOptions}"
                          IsSynchronizedWithCurrentItem="False"
                          SelectedItem="{Binding SelectedSensorOption, Mode=OneWay}"
                          SelectionChanged="cbSensor_SelectionChanged"
                          ToolTip="{Binding SelectedSensorOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding HardwareSuffix, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" Margin="8,8,0,3"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ComboBox.GroupStyle>
                </ComboBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="0% at" FontSize="11" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource HelpBadge}">
                                <TextBlock Text="?" FontSize="8.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border.ToolTip>
                                    <StackPanel MaxWidth="300">
                                        <TextBlock Text="0% at - where the needle starts" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" Text="The metric value that moves the needle to 0 % (far left). Anything at or below this value shows 0 %."/>
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                                                   Text="Example: GPU temperature with 0% at 20 and 100% at 100 → 20 °C or cooler = 0 %, 60 °C = 50 %."/>
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                                                   Text="Tip: use the lowest number printed on the dial face."/>
                                    </StackPanel>
                                </Border.ToolTip>
                            </Border>
                        </StackPanel>
                        <TextBox x:Name="txtMin" FontFamily="{DynamicResource MonoFont}" PreviewTextInput="Numeric_PreviewTextInput" KeyDown="Scale_KeyDown"
                                 LostKeyboardFocus="Scale_LostKeyboardFocus"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="100% at" FontSize="11" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource HelpBadge}">
                                <TextBlock Text="?" FontSize="8.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border.ToolTip>
                                    <StackPanel MaxWidth="300">
                                        <TextBlock Text="100% at - where the needle ends" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" Text="The metric value that moves the needle to 100 % (far right). Anything at or above this value shows 100 %."/>
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                                                   Text="Example: CPU load with 0% at 0 and 100% at 100 → the needle follows the load directly. CPU power with 100% at 150 → 150 W = full scale."/>
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                                                   Text="Tip: use the highest number printed on the dial face. Values in between are scaled linearly."/>
                                    </StackPanel>
                                </Border.ToolTip>
                            </Border>
                        </StackPanel>
                        <TextBox x:Name="txtMax" FontFamily="{DynamicResource MonoFont}" PreviewTextInput="Numeric_PreviewTextInput" KeyDown="Scale_KeyDown"
                                 LostKeyboardFocus="Scale_LostKeyboardFocus"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            </Border>

            <!-- ======================================================== footer -->
            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource ChipButton}" Click="Backlight_Click"
                        ToolTip="Backlight: fixed colour or colour rules based on the dial value">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="{Binding SwatchBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Backlight" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BacklightModeText}" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FinishSwatch}" Background="{Binding SilverSwatch}" Tag="{Binding IsSilver}"
                            ToolTip="Silver dial" Click="FinishSilver_Click"/>
                    <Button Style="{StaticResource FinishSwatch}" Background="{Binding BlackSwatch}" Tag="{Binding IsBlack}"
                            ToolTip="Black dial" Click="FinishBlack_Click"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
